# Per-machine agent config. Copy to .env on EACH laptop and change the two
# SENTINEL_BRANCH_* values — they are what tells the control plane which
# branch this machine belongs to. Two machines sharing a slug will both
# report as the same branch.
#
# Demo slugs: nairobi-hq | lagos | dubai | london | singapore | sao-paulo | new-york

CONTROL_PLANE_URL=http://localhost:8787

# 15s for the demo, not the 60s production default: this is how long it
# takes a fault you induce on stage to show up on the dashboard.
HEARTBEAT_INTERVAL_MS=15000
COMMAND_POLL_INTERVAL_MS=3000

SENTINEL_BRANCH_SLUG=lagos
SENTINEL_BRANCH_NAME=Lagos

SENTINEL_SCRIPTS_DIR=

# Optional override for the LAN address the relay dials to reach this
# machine's TightVNC. Only needed if auto-detection picks a virtual adapter
# (Docker/WSL/VirtualBox) — the agent logs a warning when it sees more than
# one candidate. Check the logged value against `ipconfig`.
SENTINEL_HOST_IP=
