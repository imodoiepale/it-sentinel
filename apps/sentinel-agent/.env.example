SUPABASE_URL=https://ncyerayycwkqytznnkrs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # run: node scripts/configure-project.mjs <project-ref>
SENTINEL_AGENT_PORT=8789

# Planner selection, in precedence order: OPENAI_API_KEY wins, then
# DEEPSEEK_BASE_URL, then StubPlanner (no model, offline fallback). The
# chosen planner is logged on startup.

# Optional — set to opt in to OpenAI-hosted planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — set to opt in to a real DeepSeek model instead of StubPlanner.
# Works for either DeepSeek's hosted API (https://api.deepseek.com/v1) or a
# self-hosted vLLM/Ollama endpoint serving DeepSeek open weights with
# --tool-call-parser deepseek_v3 (or deepseek_v31 for V3.1) so it exposes
# the same OpenAI-compatible tool_calls JSON shape.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
