# The relay MUST run on the same LAN as the branch machines.
#
# It opens raw TCP connections to each machine's TightVNC port on a private
# address (192.168.x.x). A cloud host — Render included — has no route to
# those, so a relay deployed there can never complete a single session. This
# is a routing fact, not a configuration preference: run this process on the
# command laptop.
#
# The control plane must advertise this machine's LAN address to browsers via
# its own RELAY_PUBLIC_URL (e.g. ws://192.168.1.50:8788). Find it with
# `ipconfig` — the IPv4 of the adapter on the venue Wi-Fi.

SUPABASE_URL=https://oohuqbxrwsjfgzigefam.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RELAY_PORT=8788
RELAY_VNC_PORT=5900

# How long to wait for a branch machine's VNC port before failing with a
# specific error. The default OS-level TCP timeout is ~21s on Windows, which
# during a demo is indistinguishable from a hang.
RELAY_CONNECT_TIMEOUT_MS=5000
