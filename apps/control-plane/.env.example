# Copy to .env (already gitignored) and fill in from your Supabase dashboard:
# Project Settings -> API -> Project URL / service_role secret key.
# NEVER commit the real .env or paste the service_role key into chat/logs —
# it bypasses RLS entirely, equivalent to a database superuser.
SUPABASE_URL=https://oohuqbxrwsjfgzigefam.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787

# Base URL the OPERATOR'S BROWSER uses to reach the VNC relay.
# On a LAN demo this is the command laptop's LAN address — find it with
# `ipconfig` and use the IPv4 of the adapter that is on the venue Wi-Fi.
# It must NOT be localhost unless the browser is on that same machine, and
# it must NOT be a Render URL: Render cannot route to 192.168.x.x.
RELAY_PUBLIC_URL=ws://127.0.0.1:8788

# Shared secret for the /v1/voice/* webhook routes that the ElevenLabs agent
# calls. Generate with:  node -e "console.log(crypto.randomUUID())"
# If unset, the voice routes refuse all requests rather than running open.
VOICE_WEBHOOK_SECRET=

# Optional: the auth.users UUID that voice-initiated actions are attributed
# to in audit_log. Defaults to the first operator holding any site grant.
VOICE_OPERATOR_ID=

# The PUBLISHABLE (anon) key — Project Settings -> API -> anon/publishable.
# Used for exactly one thing: checking an operator's password at
# /v1/auth/reauth, which is what unlocks the T4 operator console. It has to
# be this key and not the service_role one: service_role bypasses the
# password check, so re-authentication built on it would accept anything.
# If unset, /v1/auth/reauth returns 503 and T4 is simply unavailable.
SUPABASE_PUBLISHABLE_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PORTAL_URL=http://localhost:3210
DAILY_DIGEST_HOUR_UTC=5
DAILY_DIGEST_RECIPIENTS=
