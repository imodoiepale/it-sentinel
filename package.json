{
  "name": "it-sentinel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter=!@it-sentinel/web test",
    "typecheck": "pnpm --filter=./apps/* --filter=@it-sentinel/contracts --parallel exec tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test",
    "manifest": "pnpm --filter @it-sentinel/scripts manifest"
  }
}
